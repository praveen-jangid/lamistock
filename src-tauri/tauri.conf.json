{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LamiStock",
  "version": "1.0.0",
  "identifier": "com.lamistock.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LamiStock",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4OTM4QjYwMDM5NkU0RDkKUldUWjVKWURZSXVUYUJ3WXE3NUlza0o4eEE2dHlsTEYvTk4wdDRnVitXcW9DbUhMWFl5eS9IYVkK",
      "endpoints": [
        "https://github.com/praveen-jangid/lamistock/releases/latest/download/latest.json"
      ]
    }
  }
}
